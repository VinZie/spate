{
  "manifest_version": 3,
  "name": "Spate Browser Integration",
  "short_name": "Spate",
  "version": "0.1.0",
  "description": "Send browser downloads, page links and detected video/audio streams to the Spate download manager.",
  "browser_specific_settings": {
    "gecko": {
      "id": "spate@vinzie.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Spate",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": ["src/background.bundle.js"]
  },
  "permissions": [
    "downloads",
    "nativeMessaging",
    "contextMenus",
    "cookies",
    "storage",
    "webRequest",
    "webNavigation",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
